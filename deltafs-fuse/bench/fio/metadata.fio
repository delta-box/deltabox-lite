[global]
directory=${DELTAFS_FIO_DIRECTORY}
filesize=4k
nrfiles=${DELTAFS_FIO_FILES}
openfiles=1
group_reporting=1
fallocate=none

[create]
ioengine=filecreate
create_on_open=1
filename_format=metadata.$filenum

[stat]
stonewall
ioengine=filestat
filename_format=metadata.$filenum

[delete]
stonewall
ioengine=filedelete
unlink=0
filename_format=metadata.$filenum

