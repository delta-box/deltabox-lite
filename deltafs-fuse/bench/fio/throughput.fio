[global]
directory=${DELTAFS_FIO_DIRECTORY}
size=${DELTAFS_FIO_SIZE}
ioengine=psync
bs=128k
group_reporting=1
fallocate=none

[sequential-write]
rw=write
filename=sequential.data
end_fsync=1

[sequential-read]
stonewall
rw=read
filename=sequential.data

[random-mixed]
stonewall
rw=randrw
rwmixread=70
bs=4k
filename=random.data

