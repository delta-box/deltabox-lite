[global]
directory=${DELTAFS_FIO_DIRECTORY}
size=${DELTAFS_FIO_SIZE}
ioengine=psync
bs=4k
group_reporting=1
fallocate=none

[sync-write]
rw=write
filename=sync.data
fsync=1

[direct-write]
stonewall
rw=write
filename=direct.data
direct=1

[direct-read]
stonewall
rw=read
filename=direct.data
direct=1

